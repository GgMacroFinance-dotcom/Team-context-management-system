# 复制成 deploy/.env，填上真实的值。.env 已被 git 忽略，不要提交。
# PostgreSQL 的密码，用 openssl rand -hex 24 生成。只在数据卷第一次建出来时生效。
POSTGRES_PASSWORD=
# 可选：从别的机器或容器连 /mcp 时用的域名或 IP（逗号隔开），比如 ctx.example.com。
# TCMS_ALLOWED_HOSTS=
# 可选：审核页批准提议时提交者的邮箱（名字是登录的人）。
# TCMS_GIT_EMAIL=
# 可选：上下文仓库推到自己的 git 远端。https 地址配令牌（有这个仓库写权限的），地址里不要带令牌。
# TCMS_REMOTE=https://github.com/<组织>/<仓库>.git
# TCMS_GIT_TOKEN=
# Gitea、GitLab 写自己的用户名；GitHub 不用写。
# TCMS_GIT_USERNAME=
# 远端的分支，默认和本地同名（新卷是 main）。
# TCMS_REMOTE_BRANCH=
# 多久和远端同步一次（秒），默认 60；0 是只在批准、改单条时同步。
# TCMS_SYNC_SECS=60
